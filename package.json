{
  "name": "hackathon-chatapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "vite",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.js",
    "db:seed": "node --env-file-if-exists=.env server/db/seed.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:client": "vite",
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build": "vite build",
    "lint": "eslint .",
    "test:server": "node --test server/**/*.test.js"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.3.0",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "pinia": "^4.0.2",
    "socket.io": "^4.5.3",
    "socket.io-client": "^4.5.3",
    "vue": "^3.2.45",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^4.1.6",
    "vuetify": "^3.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^4.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "vite": "^4.0.0"
  }
}
