PORT=3000
DATABASE_PATH=./data/app.db
# 必須。未設定だとサーバが起動時にエラーで停止する。
# 生成例: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
SLA_WARN_HOURS=12
SLA_ALERT_HOURS=24

# P4-1（SLA監視・段階エスカレーション）で使用。上の SLA_WARN/ALERT は「緊急度」の
# 閾値、こちらは「通知」の閾値。責務が別なので混ぜないこと。
# N 時間で担当者へ通知、2N 時間で上長（role='admin'）へエスカレーションする。
SLA_NOTIFY_HOURS=24
SLA_ESCALATE_HOURS=48
# デモで実際にエスカレーションを起こすときは .env.local 側で下記まで落とす。
# 小数を受け付けるのでコード変更は不要（0.02h = 72秒 / 0.04h = 144秒）。
#   SLA_NOTIFY_HOURS=0.02
#   SLA_ESCALATE_HOURS=0.04

# P3-1（AI対応推奨度・ホームのAI現況サマリー）で使用。
# 未設定でも既存機能は動作し、AI機能だけ利用できない状態になる。
GEMINI_API_KEY=
# 無料枠対象の軽量モデル。Google側でモデル名が変わった場合はここだけ差し替える。
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PRIORITY_TIMEOUT_MS=3000
# P4-2b（コンプライアンス判定）用。送信前チェックが結果を待つ経路なので、
# 非同期の優先度判定より長く取る。実測は中央値約1秒だが、初回のみ
# TLSハンドシェイク等で3秒を超えることがある。
COMPLIANCE_AI_TIMEOUT_MS=8000
