PORT=3000
DATABASE_PATH=./data/app.db
# 必須。未設定だとサーバが起動時にエラーで停止する。
# 生成例: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
SLA_WARN_HOURS=12
SLA_ALERT_HOURS=24

# P3-1（AI対応推奨度・ホームのAI現況サマリー）で使用。
# 未設定でも既存機能は動作し、AI機能だけ利用できない状態になる。
GEMINI_API_KEY=
# 無料枠対象の軽量モデル。Google側でモデル名が変わった場合はここだけ差し替える。
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PRIORITY_TIMEOUT_MS=3000
