PORT=3000
DATABASE_PATH=./data/app.db
# 必須。未設定だとサーバが起動時にエラーで停止する。
# 生成例: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
SLA_WARN_HOURS=12
SLA_ALERT_HOURS=24

# P3-1（AI対応推奨度）で使用。未設定でも既存機能はすべて動作する。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PRIORITY_TIMEOUT_MS=3000
