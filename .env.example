PORT=3000
DATABASE_PATH=./data/app.db
# 必須。未設定だとサーバが起動時にエラーで停止する。
# 生成例: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
SLA_WARN_HOURS=12
SLA_ALERT_HOURS=24

# P3-1（AI緊急度判定）採用時のみ使用。未設定でも全機能が動作すること。
GEMINI_API_KEY=
